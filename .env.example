# Copier ce fichier en .env puis remplir avec tes valeurs (.env n'est pas versionné)
GCP_PROJECT_ID=ton-projet-gcp
# Région du dataset bike_database (US ou EU) : tous les datasets doivent être dans la même
GCP_LOCATION=US
# Préfixe des datasets créés par dbt : localbike_staging, localbike_intermediate, localbike_mart
DBT_DATASET=localbike
